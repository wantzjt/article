# Copied by `vercel env pull .env.local` after `vercel link`.
# Do not put secrets in this file.

# Vercel OIDC (preferred for AI Gateway). Pulled locally; injected on deploy.
# VERCEL_OIDC_TOKEN=

# Optional static Gateway key for CI only. Prefer OIDC.
# AI_GATEWAY_API_KEY=

PRIMARY_MODEL=zai/glm-5.2
# After 2026-08-27 23:59 CT, unset PRIMARY_MODEL (default flips to zai/glm-5.3 under $8)
# or set PRIMARY_MODEL explicitly. Do not assume 5.2 stays free.
# COMPILE_MODEL_FALLBACK=zai/glm-5.3
GLM_52_FREE_UNTIL=2026-08-27T23:59:00-05:00
MAX_DAILY_MODEL_SPEND_USD=8
EXA_PROMO_UNTIL=2026-08-31
EXA_SEARCH_TYPE=auto
EXA_NUM_RESULTS=25
EXA_CONCURRENCY=8
OCEAN_HARD_STOP=2026-08-30T23:59:00-05:00

# Protects POST /api/admin/ingest and /api/admin/refresh
ADMIN_SECRET=

# Neon via Marketplace (not required for fixture review)
# DATABASE_URL=
# DATABASE_URL_UNPOOLED=

SITE_URL=http://localhost:3000

# Private Blob store for TTS cache (optional locally; used in production)
# BLOB_READ_WRITE_TOKEN=
# BLOB_STORE_ID=
# TTS_MODEL=fish-audio/s2.1-pro

# Never set EXA_API_KEY for this app. Exa is gateway.tools.exaSearch()
# (Eve/AI Gateway promo through EXA_PROMO_UNTIL).
